{
  "Commands": [
    {
      "name": "Lock",
      "command": "swaylock"
    },
    {
      "name": "Logout",
      "command": "loginctl terminate-user $USER"
    },
    {
      "name": "Shutdown",
      "command": "systemctl poweroff"
    },
    {
      "name": "Reboot",
      "command": "systemctl reboot"
    },
    {
      "name": "Suspend",
      "command": "systemctl suspend"
    },
    {
      "name": "Hibernate",
      "command": "systemctl hibernate"
    }
  ]
}

